include _mixins.jade

doctype html

html
    head
        +defaultmeta()
        title Aw_Man3703 ; Skills
        +defaultcss("skills")
    body
        h1#title My Skills

        div#search
            input(placeholder="⌕ Search...")#search-bar
            button#search-reset  𐔧

        div#skills-list
            ul#tools.skills
                li Jetbrains Suite
                    span Webstorm, IntelliJ&nbsp;IDEA, Rider, Pycharm
                li Visual Studio & Visual Studio Code
                li Sublime Text
                li XCode
                li Unreal Engine
                li Godot
                li Android studio
                li Postman
                li Proxyman
                li Wireshark

            ul#frameworks.skills
                li pandas/numpy
                li tensorflow
                li .NET & WPF
                li SwiftUI
                li Jetpack Compose
                li ExpressJS
                li HaxeFlixel
                li USB & UVC Camera hardware

            ul#languages.skills
                li Javascript/Typescript
                li Python
                li Java/Kotlin
                li C/C#
                li HTML/Pug & CSS/LessCSS
                li Lua
                li Haxe
                li.text-secondary (...and MCFunction)

            ul#non-programming.skills
                li Blender (basic)
                li Aseprite
                li Adobe Suite
                    span Photoshop, Illustrator, InDesign, Dreamweaver
                    span & open-source alternatives
                li MagicaVoxel
                li Roblox Studio
                li Notion
                li Obsidian

        +defaultjs("skills")